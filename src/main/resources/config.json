      "sshConfiguration": [
        {
          "name": "Temperature NVME 01",
          "type": "SMARTCTL",
          "device": "nvme0n1",
          "threshold": 70
        },
        {
          "name": "Temperature SDA",
          "type": "SMARTCTL",
          "device": "sda",
          "grep": "Current Temperature",
          "threshold": 70
        },
        {
          "name": "Temperature SDB",
          "type": "SMARTCTL",
          "device": "sdb",
          "threshold": 70
        },
        {
          "name": "Temperature SDC",
          "type": "SMARTCTL",
          "device": "sdc",
          "threshold": 70
        },
        {
          "name": "Temperature SDD",
          "type": "CUSTOM",
          "command": "smartctl -l scttemp /dev/sdd | grep 'Current Temperature'",
          "threshold": 70
        },
        {
          "name": "CPU Temperature",
          "type": "SENSORS",
          "grep": "Package id 0",
          "threshold": 70
        }
      ]
    }
  ]
